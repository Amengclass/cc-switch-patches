diff --git a/src-tauri/Cargo.toml b/src-tauri/Cargo.toml
index 9325814f..503c67bc 100644
--- a/src-tauri/Cargo.toml
+++ b/src-tauri/Cargo.toml
@@ -1,5 +1,5 @@
 [package]
-name = "cc-switch"
+name = "cc-switch-magic"
 version = "4.0.4"
 description = "All-in-One Assistant for Claude Code, Codex & Gemini CLI"
 authors = ["Jason Young"]
@@ -27,7 +27,7 @@ serde_json = { version = "1.0", features = ["preserve_order"] }
 serde = { version = "1.0", features = ["derive"] }
 log = "0.4"
 chrono = { version = "0.4", features = ["serde"] }
-tauri = { version = "2.8.2", features = ["tray-icon", "protocol-asset", "image-png"] }
+tauri = { version = "2.8.2", features = ["tray-icon", "protocol-asset", "image-png", "macos-private-api"] }
 tauri-plugin-log = "2"
 tauri-plugin-opener = "2"
 tauri-plugin-process = "2"
@@ -42,6 +42,8 @@ toml_edit = "0.22"
 reqwest = { version = "0.12", features = ["rustls-tls", "json", "stream", "socks"] }
 arboard = "3.6"
 flate2 = "1"
+# 远端 SSH：SFTP 收发、SSH 连接。tar 用于把目录打包成流过去（远端 skill 同步）
+tar = "0.4"
 brotli = "7"
 zstd = "0.13"
 tokio = { version = "1", features = ["macros", "rt-multi-thread", "time", "sync"] }
@@ -82,6 +84,10 @@ hmac = "0.12"
 json5 = "0.4"
 json-five = "0.3.1"
 sys-locale = "0.3"
+# 远端主机：SSH 连接与 SFTP；密码经 keyring/DPAPI 存取
+russh = "0.62.5"
+russh-sftp = "2.3.0"
+keyring = "3.6.3"
 
 [target.'cfg(any(target_os = "macos", target_os = "windows", target_os = "linux"))'.dependencies]
 tauri-plugin-single-instance = "2"
@@ -98,6 +104,13 @@ windows-sys = { version = "0.61", features = [
     "Win32_Globalization",
     "Win32_Storage_FileSystem",
     "Win32_UI_Shell",
+    # 悬浮窗：全局光标轮询 + 左键状态（拖动绕开 WebView 事件）
+    "Win32_Foundation",
+    "Win32_UI_WindowsAndMessaging",
+    "Win32_UI_Input_KeyboardAndMouse",
+    # 远端：密码用 DPAPI（CryptProtectData）加密后落盘
+    "Win32_Security_Cryptography",
+    "Win32_System_Memory",
 ] }
 
 [target.'cfg(all(target_os = "windows", target_arch = "aarch64"))'.dependencies]
@@ -118,6 +131,12 @@ opt-level = "s"
 panic = "unwind"
 strip = "symbols"
 
+# dev 构建：主 crate 体量大，默认 debuginfo=2 时 rustc/LLVM 峰值内存过高，
+# 16G 机器上会 OOM（rustc-LLVM ERROR: out of memory / STATUS_STACK_BUFFER_OVERRUN）。
+# line-tables-only 保留行号（panic hook 的 backtrace 仍可读），但大幅降低 codegen 内存。
+[profile.dev]
+debug = "line-tables-only"
+
 [dev-dependencies]
 serial_test = "3"
 tempfile = "3"
