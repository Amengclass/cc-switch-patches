+    let id = row.get("session_id").and_then(Value::as_str)?.to_string();
+    Some(SessionMeta {
+        provider_id: "mcode".into(),
+        source_path: Some(format!("mcode:{id}")),
+        resume_command: None,
+        session_id: id,
+        title: row
+            .get("title")
+            .and_then(Value::as_str)
+            .map(str::to_string),
+        summary: None,
+        project_dir: row
+            .get("workspace_dir")
